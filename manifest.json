{
  "manifest_version": 3,
  "name": "FunPay Dark Theme",
  "version": "1.2.0",
  "description": "Тёмная AMOLED-тема для funpay.com и support.funpay.com.",
  "permissions": ["storage"],
  "action": {
    "default_title": "FunPay Dark Theme",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*",
        "https://*.funpay.com/*",
        "http://funpay.com/*",
        "http://*.funpay.com/*"
      ],
      "css": ["theme.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "funpay-dark-theme@funpay-dark-theme.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
